MERGE (n:Cathode {uid: "CATHODE-MOD-FC85"}) SET n += {uid: "CATHODE-MOD-FC85", materialsList: ["Nickel", "Manganese", "Cobalt", "Lithium"], percentageList: [56, 7, 7, 30], isRenewable: [false, false, false, false]};
