CREATE CONSTRAINT bp_logisticsstep_uid IF NOT EXISTS FOR (n:LogisticsStep) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_message_uid IF NOT EXISTS FOR (n:Message) REQUIRE n.uid IS UNIQUE;
