// Jeu de données de démo Battery Passport (généré par scripts/export_cypher.py)
CREATE CONSTRAINT bp_actor_uid IF NOT EXISTS FOR (n:Actor) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_anode_uid IF NOT EXISTS FOR (n:Anode) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_batteryinstance_uid IF NOT EXISTS FOR (n:BatteryInstance) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_carbonfootprint_uid IF NOT EXISTS FOR (n:CarbonFootprint) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_cathode_uid IF NOT EXISTS FOR (n:Cathode) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_certification_uid IF NOT EXISTS FOR (n:Certification) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_circularity_uid IF NOT EXISTS FOR (n:Circularity) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_company_uid IF NOT EXISTS FOR (n:Company) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_composition_uid IF NOT EXISTS FOR (n:Composition) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_dynamicdurability_uid IF NOT EXISTS FOR (n:DynamicDurability) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_dynamicperformance_uid IF NOT EXISTS FOR (n:DynamicPerformance) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_economicoperator_uid IF NOT EXISTS FOR (n:EconomicOperator) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_electrolyte_uid IF NOT EXISTS FOR (n:Electrolyte) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_event_uid IF NOT EXISTS FOR (n:Event) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_marketdemand_uid IF NOT EXISTS FOR (n:MarketDemand) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_model_uid IF NOT EXISTS FOR (n:Model) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_module_uid IF NOT EXISTS FOR (n:Module) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_staticdurability_uid IF NOT EXISTS FOR (n:StaticDurability) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_staticperformance_uid IF NOT EXISTS FOR (n:StaticPerformance) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_type_uid IF NOT EXISTS FOR (n:Type) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_notification_uid IF NOT EXISTS FOR (n:Notification) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_transferorder_uid IF NOT EXISTS FOR (n:TransferOrder) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_decision_uid IF NOT EXISTS FOR (n:Decision) REQUIRE n.uid IS UNIQUE;
MERGE (n:Company {uid: "CMP-FLUX"}) SET n += {uid: "CMP-FLUX", name: "Flux Motors"};
MERGE (n:Type {uid: "TYPE-EV"}) SET n += {uid: "TYPE-EV", name: "Batterie de traction VE"};
MERGE (n:EconomicOperator {uid: "EO-FLUX"}) SET n += {uid: "EO-FLUX", name: "Flux Motors SAS", address: "1 avenue du Temps, 92000 Nanterre", country: "FR", email: "passport@fluxmotors.example", phone: "+33 1 00 00 00 00", website: "https://fluxmotors.example"};
