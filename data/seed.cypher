// Jeu de données de démo Battery Passport (généré par scripts/export_cypher.py)
CREATE CONSTRAINT bp_actor_uid IF NOT EXISTS FOR (n:Actor) REQUIRE n.uid IS UNIQUE;
CREATE CONSTRAINT bp_anode_uid IF NOT EXISTS FOR (n:Anode) REQUIRE n.uid IS UNIQUE;
