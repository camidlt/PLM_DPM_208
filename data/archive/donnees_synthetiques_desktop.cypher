"2026-11-04T09:00:00Z", voltage: 3.14, current: 11.84, internalResistance: 47.3, temperature: 25.8}, {measurementId: "MF48-S0100-M5-X1", ts: "2026-11-04T09:00:02Z", voltage: 3.136, current: 11.95, internalResistance: 47.2, temperature: 26.1}, {measurementId: "MF48-S0100-M5-X2", ts: "2026-11-04T09:00:04Z", voltage: 3.14, current: 11.84, internalResistance: 47.3, temperature: 26.4}], alerts: [], latestId: "MF48-S0100-M5-X2", props: {position: 5, health: "OK", consecutiveOver: 0, lastResistance: 47.3, lastTemperature: 26.4, lastTs: "2026-11-04T09:00:04Z", internalResistanceIncrease: 57.7}}]}] AS d
MATCH (m:Model {modelId: d.model})<-[:HAS_MODEL]-(:Type)<-[:HAS_TYPE]-(:Company)-[:HAS_ECONOMIC_OPERATOR]->(o:EconomicOperator)
MATCH (m)-[:HAS_STATIC_PERFORMANCE]->(sp)
MERGE (b:BatteryInstance {batteryId: d.id})
SET b.status = d.status, b.batteryPassportId = 'BP-' + d.id, b.serialNumber = d.serial,
    b.manufacturingDate = d.made, b.dateOfPuttingIntoService = d.service,
    b.currentHolder = d.holder, b.installedIn = d.installedIn, b.recyclingStatus = d.recyclingStatus,
    b.synthetic = true, b.syntheticProfile = d.profile, b.previousBatteryPassportId = d.previousPassport
MERGE (m)-[:HAS_BATTERY_INSTANCE]->(b)
MERGE (o)-[:BUILD]->(b)
MERGE (dp:DynamicPerformance {batteryId: d.id}) SET dp += d.dp
MERGE (b)-[:HAS_DYNAMIC_PERFORMANCE]->(dp)
MERGE (dd:DynamicDurability {batteryId: d.id}) SET dd += d.dd
MERGE (b)-[:HAS_DYNAMIC_DURABILITY]->(dd)
MERGE (b)-[:HAS_EVENT]->(e:Event {eventId: d.id + '-MANUFACTURED'})
  ON CREATE SET e.type = 'MANUFACTURED', e.ts = d.made + '-15T08:00:00Z', e.role = 'manufacturer',
                e.by = o.name, e.details = 'Fabrication – S/N ' + d.serial
FOREACH (ev IN d.events | MERGE (b)-[:HAS_EVENT]->(x:Event {eventId: ev.eventId}) ON CREATE SET x += ev)
FOREACH (pp IN CASE WHEN d.previousPassport IS NULL THEN [] ELSE [d.previousPassport] END |
  MERGE (ap:ArchivedPassport {batteryPassportId: pp})
    ON CREATE SET ap.lastStatus = 'Waste', ap.reason = 'Réaffectation (seconde vie)'
  MERGE (b)-[:DERIVED_FROM]->(ap))
WITH b, d, sp
UNWIND d.modules AS mo
MERGE (mod:Module {moduleId: d.id + '-M' + toString(mo.position)})
SET mod += mo.props, mod.initialInternalResistance = sp.initialInternalResistanceModule,
    mod.maxResistance = sp.maxInternalResistance
MERGE (b)-[:HAS_MODULE]->(mod)
FOREACH (x IN mo.measurements | MERGE (mod)-[:HAS_MEASUREMENT]->(me:Measurement {measurementId: x.measurementId})
  ON CREATE SET me += x)
FOREACH (a IN mo.alerts | MERGE (mod)-[:RAISED]->(al:Alert {alertId: a.alertId}) ON CREATE SET al += a)
WITH mod, mo
MATCH (mod)-[:HAS_MEASUREMENT]->(last:Measurement {measurementId: mo.latestId})
OPTIONAL MATCH (mod)-[old:LATEST]->()
DELETE old
MERGE (mod)-[:LATEST]->(last);

