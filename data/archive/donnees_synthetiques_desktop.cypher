// =====================================================================
// TOUT-EN-UN pour Neo4j Desktop : modèles + 7 batteries de démo + rôles/droits + batteries synthétiques
// ⚠ La 1re requête VIDE la base : ce fichier recrée tout de zéro.
// =====================================================================

MATCH (n) DETACH DELETE n;

// =====================================================================
// Battery Passport – jeu de données de démo (aucun dump fourni : données construites par l'équipe)
// Socle : modèle Capgemini (Figure 1 du sujet). Enrichi avec les 50 attributs Battery Pass v1.2
// retenus dans docs/Battery_Passport_selection_attributs_par_role.xlsx  ([#n] = numéro dans l'Excel).
// ★ = ajout de l'équipe. Les entreprises et personnes sont FICTIVES.
// Idempotent : on peut relancer sans doublon (MERGE ; ON CREATE pour les données qui évoluent).
// Les droits d'accès par rôle sont dans attributes.cypher (généré depuis l'Excel).
// =====================================================================

CREATE CONSTRAINT battery_id IF NOT EXISTS FOR (b:BatteryInstance) REQUIRE b.batteryId IS UNIQUE;
CREATE CONSTRAINT model_id IF NOT EXISTS FOR (m:Model) REQUIRE m.modelId IS UNIQUE;
CREATE CONSTRAINT module_id IF NOT EXISTS FOR (m:Module) REQUIRE m.moduleId IS UNIQUE;
CREATE CONSTRAINT company_name IF NOT EXISTS FOR (c:Company) REQUIRE c.name IS UNIQUE;
CREATE CONSTRAINT operator_name IF NOT EXISTS FOR (o:EconomicOperator) REQUIRE o.name IS UNIQUE;

// ---------------------------------------------------------------------
// 1) Fabricants [#4] et opérateurs économiques [#3]
// ---------------------------------------------------------------------
UNWIND [
  {company: 'Doc Brown Industries', manufacturerId: 'MFR-FR-0001', operator: 'DeLorean Motor Company', operatorId: 'OP-FR-1985',
   address: '1640 Riverside Drive, Hill Valley', country: 'FR', email: 'passport@dmc.example',
   phone: '+33 1 85 19 85 00', weblink: 'https://dmc.example'},
  {company: 'Hill Valley Energy', manufacturerId: 'MFR-FR-0002', operator: 'HVE Manufacturing Europe', operatorId: 'OP-FR-2015',
   address: 'ZI des Lumières, 59000 Lille', country: 'FR', email: 'compliance@hve.example',
   phone: '+33 3 20 20 15 00', weblink: 'https://hve.example'},
  {company: 'Mr. Fusion Mobility', manufacturerId: 'MFR-DE-0003', operator: 'Mr. Fusion GmbH', operatorId: 'OP-DE-1955',
   address: 'Energiestraße 12, 70173 Stuttgart', country: 'DE', email: 'bp@mrfusion.example',
   phone: '+49 711 1955 000', weblink: 'https://mrfusion.example'}
] AS d
MERGE (c:Company {name: d.company}) SET c.manufacturerId = d.manufacturerId
MERGE (o:EconomicOperator {name: d.operator})
SET o.operatorId = d.operatorId, o.address = d.address, o.country = d.country, o.email = d.email,
    o.phone = d.phone, o.weblink = d.weblink
MERGE (c)-[:HAS_ECONOMIC_OPERATOR]->(o);

// ---------------------------------------------------------------------
// 2) Modèles de batterie et toutes leurs données statiques
// ---------------------------------------------------------------------
UNWIND [
  {modelId: 'FC-88', name: 'Flux Capacitor Pack FC-88 (75 kWh)', company: 'Doc Brown Industries',
   operator: 'DeLorean Motor Company', type: 'Electric Vehicle Battery', place: 'Hill Valley Gigafactory (FR)', mass: 478,
   chemistry: 'NMC 811 / Graphite-Si', crm: ['Lithium', 'Nickel', 'Cobalt', 'Manganese', 'Natural graphite'],
   hazardous: ['LiPF6 (électrolyte, dégage du HF en cas de feu)', 'Composés de cobalt', 'Composés de nickel'],
   minV: 280.0, nomV: 355.0, maxV: 403.0, ratedCapacity: 211, irPack: 40.0, irModule: 8.0, irCell: 1.2, maxIR: 25.0,
   cycles: 2000, cRate: 1.0, threshold: 70.0, cf: 61.5, cfClass: 'B', extinguish: 'Eau en grande quantité',
   recNi: 6.0, recCo: 16.0, recLi: 6.0, recPb: 0.0, renewable: 2.0,
   anode: ['Graphite', 'Silicon oxide', 'Copper foil', 'Binder (SBR/CMC)'], anodePct: [86, 6, 6, 2], anodeRen: [false, false, false, false],
   cathode: ['LiNi0.8Mn0.1Co0.1O2', 'Aluminium foil', 'Carbon black', 'PVDF binder'], cathodePct: [90, 5, 3, 2], cathodeRen: [false, false, false, false],
   electrolyte: ['LiPF6', 'Ethylene carbonate', 'Ethyl methyl carbonate', 'Additives (VC/FEC)'], electrolytePct: [13, 30, 52, 5], electrolyteRen: [false, false, false, false]},
  {modelId: 'HV-LFP-60', name: 'Hoverboard LFP Pack HV-60 (60 kWh)', company: 'Hill Valley Energy',
   operator: 'HVE Manufacturing Europe', type: 'Electric Vehicle Battery', place: 'Lille (FR)', mass: 395,
   chemistry: 'LFP / Graphite', crm: ['Lithium', 'Natural graphite', 'Phosphate rock'],
   hazardous: ['LiPF6 (électrolyte, dégage du HF en cas de feu)'],
   minV: 250.0, nomV: 320.0, maxV: 365.0, ratedCapacity: 188, irPack: 32.5, irModule: 6.5, irCell: 0.9, maxIR: 20.0,
   cycles: 3500, cRate: 1.0, threshold: 70.0, cf: 48.2, cfClass: 'A', extinguish: 'Eau / mousse',
   recNi: 0.0, recCo: 0.0, recLi: 8.0, recPb: 0.0, renewable: 3.0,
   anode: ['Graphite', 'Copper foil', 'Binder (SBR/CMC)'], anodePct: [91, 7, 2], anodeRen: [false, false, false],
   cathode: ['LiFePO4', 'Aluminium foil', 'Carbon black', 'PVDF binder'], cathodePct: [88, 6, 4, 2], cathodeRen: [false, false, false, false],
   electrolyte: ['LiPF6', 'Ethylene carbonate', 'Dimethyl carbonate'], electrolytePct: [12, 44, 44], electrolyteRen: [false, false, false]},
  {modelId: 'MF-48', name: 'Mr. Fusion e-Bike Pack MF-48 (0,75 kWh)', company: 'Mr. Fusion Mobility',
   operator: 'Mr. Fusion GmbH', type: 'Light Means of Transport Battery', place: 'Stuttgart (DE)', mass: 4.1,
   chemistry: 'NMC 622 / Graphite', crm: ['Lithium', 'Nickel', 'Cobalt', 'Manganese', 'Natural graphite'],
   hazardous: ['LiPF6 (électrolyte, dégage du HF en cas de feu)', 'Composés de cobalt', 'Composés de nickel'],
   minV: 39.0, nomV: 48.0, maxV: 54.6, ratedCapacity: 16, irPack: 150.0, irModule: 30.0, irCell: 25.0, maxIR: 60.0,
   cycles: 1000, cRate: 0.5, threshold: 70.0, cf: 72.0, cfClass: 'C', extinguish: 'Eau / sable',
   recNi: 4.0, recCo: 12.0, recLi: 4.0, recPb: 0.0, renewable: 0.0,
   anode: ['Graphite', 'Copper foil', 'Binder'], anodePct: [90, 8, 2], anodeRen: [false, false, false],
   cathode: ['LiNi0.6Mn0.2Co0.2O2', 'Aluminium foil', 'Carbon black', 'PVDF binder'], cathodePct: [89, 6, 3, 2], cathodeRen: [false, false, false, false],
   electrolyte: ['LiPF6', 'Ethylene carbonate', 'Diethyl carbonate'], electrolytePct: [12, 40, 48], electrolyteRen: [false, false, false]},
  {modelId: 'CT-200', name: 'Clocktower Storage Unit CT-200 (200 kWh)', company: 'Hill Valley Energy',
   operator: 'HVE Manufacturing Europe', type: 'Industrial Battery', place: 'Lille (FR)', mass: 1650,
   chemistry: 'LFP / Graphite', crm: ['Lithium', 'Natural graphite', 'Phosphate rock'],
   hazardous: ['LiPF6 (électrolyte, dégage du HF en cas de feu)'],
   minV: 672.0, nomV: 768.0, maxV: 876.0, ratedCapacity: 260, irPack: 25.0, irModule: 5.0, irCell: 0.3, maxIR: 18.0,
   cycles: 6000, cRate: 0.5, threshold: 60.0, cf: 45.0, cfClass: 'A', extinguish: 'Eau / système aérosol',
   recNi: 0.0, recCo: 0.0, recLi: 10.0, recPb: 0.0, renewable: 5.0,
   anode: ['Graphite', 'Copper foil', 'Binder (SBR/CMC)'], anodePct: [91, 7, 2], anodeRen: [false, false, false],
   cathode: ['LiFePO4', 'Aluminium foil', 'Carbon black', 'PVDF binder'], cathodePct: [88, 6, 4, 2], cathodeRen: [false, false, false, false],
   electrolyte: ['LiPF6', 'Ethylene carbonate', 'Dimethyl carbonate'], electrolytePct: [12, 44, 44], electrolyteRen: [false, false, false]}
] AS d
MATCH (c:Company {name: d.company}), (o:EconomicOperator {name: d.operator})
MERGE (t:Type {name: d.type})                                                         // [#9]
MERGE (c)-[:HAS_TYPE]->(t)
MERGE (m:Model {modelId: d.modelId})
SET m.name = d.name, m.manufacturingPlace = d.place, m.batteryMass = d.mass            // ★ [#5] [#10] kg
MERGE (t)-[:HAS_MODEL]->(m)

MERGE (sp:StaticPerformance {modelId: d.modelId})
SET sp.minimalVoltage = d.minV, sp.nominalVoltage = d.nomV, sp.maximalVoltage = d.maxV,     // [#59-61] V
    sp.ratedCapacity = d.ratedCapacity,                                                      // ★ [#52] Ah
    sp.initialInternalResistancePack = d.irPack, sp.initialInternalResistanceModule = d.irModule,
    sp.initialInternalResistanceCell = d.irCell,                                             // ★ [#74] mΩ
    sp.maxInternalResistance = d.maxIR, sp.internalResistanceUnit = 'mOhm'                   // ★ seuil défi 1
MERGE (m)-[:HAS_STATIC_PERFORMANCE]->(sp)

MERGE (sd:StaticDurability {modelId: d.modelId})
SET sd.expectedBatteryLifetimeCycles = d.cycles,                                             // [#77]
    sd.cRateRelevantCycleLifeTest = d.cRate,                                                 // socle Capgemini
    sd.capacityThresholdForExhaustion = d.threshold                                          // ★ [#83] %
MERGE (m)-[:HAS_STATIC_DURABILITY]->(sd)

MERGE (cert:Certification {modelId: d.modelId})
SET cert.separateCollectionSymbol = 'Poubelle barrée (EN IEC 62902)',                       // [#12]
    cert.EUDeclarationOfConformityId = 'EU-DoC-' + d.modelId + '-2026',                     // [#17]
    cert.EUDeclarationOfConformity = 'https://docs.example/' + d.modelId + '/eu-declaration-of-conformity.pdf'
MERGE (m)-[:HAS_CERTIFICATION]->(cert)

MERGE (circ:Circularity {modelId: d.modelId})
SET circ.extinguishAgent = d.extinguish,                                                     // [#15]
    circ.partNumbers = 'https://docs.example/' + d.modelId + '/part-numbers',                // [#37]
    circ.dismantlingInformation = 'https://docs.example/' + d.modelId + '/dismantling-manual.pdf',  // ★ [#36]
    circ.sparePartsSources = 'https://docs.example/' + d.modelId + '/spare-parts-sources',   // ★ [#38]
    circ.safetyMeasures = 'https://docs.example/' + d.modelId + '/safety-measures.pdf',      // ★ [#39]
    circ.endOfLifeInformation = 'https://docs.example/' + d.modelId + '/collection-second-life-eol.pdf',  // ★ [#51]
    circ.recycledNickelShare = d.recNi, circ.recycledCobaltShare = d.recCo,                  // ★ [#44] [#45] %
    circ.recycledLithiumShare = d.recLi, circ.recycledLeadShare = d.recPb,                   // ★ [#46] [#47] %
    circ.renewableContentShare = d.renewable                                                 // ★ [#48] %
MERGE (m)-[:HAS_CIRCULARITY]->(circ)

MERGE (cf:CarbonFootprint {modelId: d.modelId})
SET cf.carbonFootprintDeclared = d.cf, cf.unit = 'kg CO2e / kWh',                           // [#19]
    cf.performanceClass = d.cfClass,                                                         // [#24]
    cf.linkStudy = 'https://docs.example/' + d.modelId + '/carbon-footprint-study.pdf'       // socle Capgemini
MERGE (m)-[:HAS_CARBON_FOOTPRINT]->(cf)
MERGE (o)-[:HAS_CARBON_FOOTPRINT]->(cf)

MERGE (comp:Composition {composition_id: d.modelId + '-COMP'})
SET comp.batteryChemistry = d.chemistry,                                                     // [#31]
    comp.criticalRawMaterials = d.crm,                                                       // ★ [#32]
    comp.hazardousSubstances = d.hazardous                                                   // ★ [#34]
MERGE (m)-[:HAS_COMPOSITION]->(comp)
MERGE (an:Anode {anodeId: d.modelId + '-AN'})                                                // [#33]
SET an.anodeMaterialsList = d.anode, an.percentageList = d.anodePct, an.isRenewable = d.anodeRen
MERGE (comp)-[:HAS_ANODE]->(an)
MERGE (ca:Cathode {cathodeId: d.modelId + '-CA'})
SET ca.cathodeMaterialsList = d.cathode, ca.percentageList = d.cathodePct, ca.isRenewable = d.cathodeRen
MERGE (comp)-[:HAS_CATHODE]->(ca)
MERGE (el:Electrolyte {electrolyteId: d.modelId + '-EL'})
SET el.electrolyteMaterialsList = d.electrolyte, el.percentageList = d.electrolytePct, el.isRenewable = d.electrolyteRen
MERGE (comp)-[:HAS_ELECTROLYTE]->(el);

// ---------------------------------------------------------------------
// 3) Batteries physiques + données dynamiques
//    Statuts imposés [#11] : Original, Re-used, Remanufactured, Repurposed, Waste
// ---------------------------------------------------------------------
UNWIND [
  {id: 'DLR-1985', model: 'FC-88', status: 'Original', made: '2025-10', service: '2025-11', serial: 'FC88-25-001985',
   holder: 'Dr. Emmett Brown', installedIn: 'DeLorean DMC-12', warranty: '2033-10', accidents: 'Aucun accident déclaré',
   dp: {soce: 71, soc: 64, capacityFade: 29.0, remainingPowerCapability: 167000, powerFade: 33.0, internalResistanceIncrease: 0.0},
   dd: {numberOfFullCycles: 640, temperatureInformation: 31, timeExtremeTempAbove: 540, timeExtremeTempBelow: 0,
        deepDischargeEvents: 3, overchargeEvents: 1}},
  {id: 'DLR-2015', model: 'FC-88', status: 'Original', made: '2026-02', service: '2026-03', serial: 'FC88-26-002015',
   holder: 'Marty McFly', installedIn: 'DeLorean DMC-12', warranty: '2034-02', accidents: 'Aucun accident déclaré',
   dp: {soce: 94, soc: 80, capacityFade: 6.0, remainingPowerCapability: 240000, powerFade: 4.0, internalResistanceIncrease: 3.0},
   dd: {numberOfFullCycles: 180, temperatureInformation: 24, timeExtremeTempAbove: 0, timeExtremeTempBelow: 0,
        deepDischargeEvents: 0, overchargeEvents: 0}},
  {id: 'DLR-1955', model: 'FC-88', status: 'Waste', made: '2025-11', service: '2025-12', serial: 'FC88-25-001955',
   holder: 'Biff Tannen', installedIn: 'Ford Super De Luxe', warranty: '2033-11',
   accidents: 'Collision avec un camion de fumier (2026-06) – choc sur le pack',
   dp: {soce: 38, soc: 0, capacityFade: 62.0, remainingPowerCapability: 90000, powerFade: 64.0, internalResistanceIncrease: 140.0},
   dd: {numberOfFullCycles: 1900, temperatureInformation: 22, timeExtremeTempAbove: 2400, timeExtremeTempBelow: 300,
        deepDischargeEvents: 12, overchargeEvents: 5}},
  {id: 'HVB-0001', model: 'HV-LFP-60', status: 'Original', made: '2026-03', service: '2026-04', serial: 'HV60-26-000001',
   holder: 'Jennifer Parker', installedIn: 'Citadine électrique', warranty: '2034-03', accidents: 'Aucun accident déclaré',
   dp: {soce: 97, soc: 55, capacityFade: 3.0, remainingPowerCapability: 178000, powerFade: 1.0, internalResistanceIncrease: 1.0},
   dd: {numberOfFullCycles: 90, temperatureInformation: 23, timeExtremeTempAbove: 0, timeExtremeTempBelow: 0,
        deepDischargeEvents: 0, overchargeEvents: 0}},
  {id: 'HVB-0002', model: 'HV-LFP-60', status: 'Repurposed', made: '2025-06', service: '2025-07', serial: 'HV60-25-000002',
   holder: 'Station de recharge A6 (stockage stationnaire)', installedIn: 'Container de stockage', warranty: '2033-06',
   accidents: 'Aucun accident déclaré',
   dp: {soce: 66, soc: 90, capacityFade: 34.0, remainingPowerCapability: 130000, powerFade: 28.0, internalResistanceIncrease: 22.0},
   dd: {numberOfFullCycles: 2600, temperatureInformation: 26, timeExtremeTempAbove: 60, timeExtremeTempBelow: 0,
        deepDischargeEvents: 1, overchargeEvents: 0}},
  {id: 'MF-0042', model: 'MF-48', status: 'Re-used', made: '2026-04', service: '2026-05', serial: 'MF48-26-000042',
   holder: 'Loueur de VTT Hill Valley', installedIn: 'VTT électrique', warranty: '2028-04', accidents: 'Aucun accident déclaré',
   dp: {soce: 82, soc: 70, capacityFade: 18.0, remainingPowerCapability: 1250, powerFade: 17.0, internalResistanceIncrease: 12.0},
   dd: {numberOfFullCycles: 310, temperatureInformation: 21, timeExtremeTempAbove: 30, timeExtremeTempBelow: 0,
        deepDischargeEvents: 2, overchargeEvents: 0}},
  {id: 'CTS-1885', model: 'CT-200', status: 'Original', made: '2026-01', service: '2026-02', serial: 'CT200-26-001885',
   holder: 'Mairie de Hill Valley (stockage solaire)', installedIn: 'Local technique', warranty: '2036-01',
   accidents: 'Aucun accident déclaré',
   dp: {soce: 90, soc: 48, capacityFade: 10.0, remainingPowerCapability: 95000, powerFade: 5.0, internalResistanceIncrease: 4.0},
   dd: {numberOfFullCycles: 250, temperatureInformation: 25, timeExtremeTempAbove: 0, timeExtremeTempBelow: 0,
        deepDischargeEvents: 0, overchargeEvents: 0}}
] AS d
MATCH (m:Model {modelId: d.model})<-[:HAS_MODEL]-(:Type)<-[:HAS_TYPE]-(:Company)-[:HAS_ECONOMIC_OPERATOR]->(o:EconomicOperator)
MERGE (b:BatteryInstance {batteryId: d.id})                                                // [#2]
  ON CREATE SET b.status = d.status                                                        // [#11]
SET b.batteryPassportId = 'BP-' + d.id,                                                    // [#1]
    b.serialNumber = d.serial,                                                             // ★ [#2]
    b.manufacturingDate = d.made, b.dateOfPuttingIntoService = d.service,                  // ★ [#6] [#7]
    b.currentHolder = d.holder, b.installedIn = d.installedIn                              // ★ contexte démo
MERGE (m)-[:HAS_BATTERY_INSTANCE]->(b)
MERGE (o)-[:BUILD]->(b)
MERGE (dd:DynamicDurability {batteryId: d.id})
SET dd.warranty = d.warranty                                                               // [#8]
MERGE (b)-[:HAS_DYNAMIC_DURABILITY]->(dd)
MERGE (dp:DynamicPerformance {batteryId: d.id})
MERGE (b)-[:HAS_DYNAMIC_PERFORMANCE]->(dp)
MERGE (b)-[:HAS_EVENT]->(e:Event {eventId: d.id + '-MANUFACTURED'})
  ON CREATE SET e.type = 'MANUFACTURED', e.ts = d.made + '-15T08:00:00Z', e.role = 'manufacturer',
                e.by = o.name, e.details = 'Fabrication – S/N ' + d.serial
WITH d, dp, dd
WHERE dp.soce IS NULL                         // données dynamiques écrites seulement à la création
// dp : [#54] [#57] [#58] [#63] [#64] [#75] – dd : [#78] [#84] [#87] [#88] [#91] [#92] [#93]
SET dp += d.dp, dd += d.dd, dd.accidents = d.accidents;

// ---------------------------------------------------------------------
// 4) ★ Défi 1 : 5 modules par batterie, avec leur résistance initiale [#74]
// ---------------------------------------------------------------------
MATCH (m:Model)-[:HAS_BATTERY_INSTANCE]->(b:BatteryInstance), (m)-[:HAS_STATIC_PERFORMANCE]->(sp)
UNWIND range(1, 5) AS i
MERGE (mod:Module {moduleId: b.batteryId + '-M' + toString(i)})
  ON CREATE SET mod.position = i, mod.health = 'OK', mod.consecutiveOver = 0
SET mod.initialInternalResistance = sp.initialInternalResistanceModule
MERGE (b)-[:HAS_MODULE]->(mod);

// ---------------------------------------------------------------------
// 5) ★ Nouveau passeport pour une batterie réaffectée (règle « Nouveau passeport » de l'Excel)
//    HVB-0002 (Repurposed) est issue d'une ancienne batterie de véhicule
// ---------------------------------------------------------------------
MATCH (b:BatteryInstance {batteryId: 'HVB-0002'})
SET b.previousBatteryPassportId = 'BP-HVB-0002-EV'
MERGE (old:ArchivedPassport {batteryPassportId: 'BP-HVB-0002-EV'})
SET old.lastStatus = 'Waste', old.archivedAt = '2025-07-01', old.reason = 'Réaffectation en stockage stationnaire'
MERGE (b)-[:DERIVED_FROM]->(old);

// ---------------------------------------------------------------------
// 6) ★ Défi 3 : centre de tri, partenaires, débouchés du marché
//    (les critères de la matrice de décision sont dans attributes.cypher)
// ---------------------------------------------------------------------
MERGE (sc:SortingCenter {name: 'Centre de tri Hill Valley'})
SET sc.accredited = true, sc.accreditation = 'Installation agréée pour le traitement des batteries usagées'
MERGE (dm:DecisionMatrix {matrixId: 'DM-v1'})
MERGE (sc)-[:USES]->(dm)
WITH sc
UNWIND [
  {partner: 'Voltaire Second Life', kind: 'Second-life integrator', demandId: 'MD-A6',
   useCase: 'Stockage pour bornes de recharge – aire d’autoroute A6', path: 'Repurpose', minSoce: 60, maxIrIncrease: 50,
   category: 'any', chemistry: 'any', quantity: 12, urgency: 'HIGH', deadline: '2026-12-15'},
  {partner: 'Voltaire Second Life', kind: 'Second-life integrator', demandId: 'MD-VTT',
   useCase: 'Gamme de VTT électriques de seconde main', path: 'Reuse', minSoce: 80, maxIrIncrease: 30,
   category: 'Light Means of Transport Battery', chemistry: 'any', quantity: 50, urgency: 'MEDIUM', deadline: '2027-03-01'},
  {partner: 'ReCell Atelier', kind: 'Remanufacturer', demandId: 'MD-REMAN-FC88',
   useCase: 'Packs FC-88 reconditionnés (remplacement de modules)', path: 'Remanufacture', minSoce: 60, maxIrIncrease: 50,
   category: 'Electric Vehicle Battery', chemistry: 'NMC 811', quantity: 5, urgency: 'LOW', deadline: '2027-06-30'},
  {partner: 'Hill Valley Recycling', kind: 'Recycler', demandId: 'MD-NICO',
   useCase: 'Récupération nickel et cobalt (hydrométallurgie)', path: 'Recycle', minSoce: 0, maxIrIncrease: 100000,
   category: 'any', chemistry: 'NMC', quantity: 1000, urgency: 'LOW', deadline: '2027-12-31'},
  {partner: 'Hill Valley Recycling', kind: 'Recycler', demandId: 'MD-LFP',
   useCase: 'Recyclage LFP (récupération du lithium)', path: 'Recycle', minSoce: 0, maxIrIncrease: 100000,
   category: 'any', chemistry: 'LFP', quantity: 500, urgency: 'LOW', deadline: '2027-12-31'}
] AS d
MERGE (p:Partner {name: d.partner}) SET p.kind = d.kind, p.accredited = true
MERGE (sc)-[:HAS_PARTNER]->(p)
MERGE (md:MarketDemand {demandId: d.demandId})
  ON CREATE SET md.open = true
SET md.useCase = d.useCase, md.path = d.path, md.minSoce = d.minSoce, md.maxIrIncrease = d.maxIrIncrease,
    md.category = d.category, md.chemistry = d.chemistry, md.quantity = d.quantity, md.urgency = d.urgency,
    md.deadline = d.deadline
MERGE (p)-[:EXPRESSES]->(md);


// GÉNÉRÉ par tools/gen_attributes.py depuis l'Excel de sélection par rôle – ne pas éditer à la main

CREATE CONSTRAINT attr_num IF NOT EXISTS FOR (a:AttributeDef) REQUIRE a.num IS UNIQUE;

CREATE CONSTRAINT role_code IF NOT EXISTS FOR (r:Role) REQUIRE r.code IS UNIQUE;

UNWIND [
  {code: 'public', name: 'Grand public (QR sans connexion)', goal: 'S’informer : uniquement des attributs Public'},
  {code: 'garagiste', name: 'Garagiste', goal: 'Diagnostiquer : est-ce que je peux réparer ?'},
  {code: 'owner', name: 'Propriétaire du Battery Passport', goal: 'Valider le passage en Waste et organiser le transfert'},
  {code: 'recycler', name: 'Centre de tri', goal: 'Réceptionner, puis décider Reuse / Remanufacture / Repurpose / Recycle'}
] AS r
MERGE (x:Role {code: r.code}) SET x.name = r.name, x.goal = r.goal;

MATCH (:Role)-[c:CAN_READ|CAN_EDIT]->(:AttributeDef) DELETE c;

