{
  "version": 1,
  "author": "Hackathon ESILV - Battery Passport",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -120, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -90, "left": -110, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 30, "left": -130, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "green", [] ],
    [ "led1:A", "esp:2", "red", [] ],
    [ "led1:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
